<?xml version="1.0" encoding="utf-8"?>
<!--
  看电视 · 播放页
  设计要点（对齐项目「零基础老人」规范）：
    · 画面铺满，控件浮在画面上，4 秒无操作自动隐藏，点屏幕再唤出；
    · 触控目标 ≥96dp，文字 ≥20sp，纯图标 + 颜色区分，不依赖文字阅读；
    · 播放器自带控制条已关闭（Media3TvPlaybackEngine 里 useController=false），
      所有交互都是下面这三个按钮 —— 这就是「内置播放器方便改造」的落点；
    · **底部不放「回家」按钮**：回家统一交给桌面悬浮球（FloatingHomeButtonService），
      少一个按钮老人更不容易看花眼，也避免两个入口行为不一致。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 播放画面容器：引擎会往这里 addView 一个 PlayerView -->
    <FrameLayout
        android:id="@+id/tvPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 状态层：正在打开 / 看不了 -->
    <LinearLayout
        android:id="@+id/tvStatusPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/tvStatusIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_status_loading_icon"
            android:textSize="56sp" />

        <TextView
            android:id="@+id/tvStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/tv_status_loading"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- 失败时的两个出口：换一个台 / 回家 -->
        <LinearLayout
            android:id="@+id/tvFailureActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvFailureNext"
                android:layout_width="150dp"
                android:layout_height="96dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_tv_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/tv_failure_next"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFailureHome"
                android:layout_width="150dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_tv_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/tv_failure_home"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 顶部：当前频道名（顶部条随控件一起显隐） -->
    <LinearLayout
        android:id="@+id/tvTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B3000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChannelGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="#CCFFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- 底部：四个大按钮（上一个 / 换台 / 下一个 / 投屏） -->
    <LinearLayout
        android:id="@+id/tvBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/tvBtnPrev"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tv_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/tv_btn_prev"
                android:src="@drawable/ic_tv_prev" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tv_btn_prev"
                android:textColor="@android:color/white"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvBtnList"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tv_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/tv_btn_list"
                android:src="@drawable/ic_tv_list" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tv_btn_list"
                android:textColor="@android:color/white"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvBtnNext"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tv_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/tv_btn_next"
                android:src="@drawable/ic_tv_next" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tv_btn_next"
                android:textColor="@android:color/white"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvBtnCast"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tv_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/tv_btn_cast"
                android:src="@drawable/ic_tv_cast" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tv_btn_cast"
                android:textColor="@android:color/white"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
